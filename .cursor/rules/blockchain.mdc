## USYC Deposit Pattern

USYC is deposited via the **Teller contract** (`USYC_TELLER`).
Users must first be added to the **Entitlements** whitelist.

```typescript
// lib/arc/usyc.ts
import { createPublicClient, createWalletClient, http, parseUnits, formatUnits } from 'viem';
import { arcTestnet } from './viem-chain';
import { CONTRACTS } from './contracts';

// Teller ABI (deposit function — verify exact ABI from Circle docs or contract)
const TELLER_ABI = [
  {
    name: 'deposit',
    type: 'function',
    inputs: [{ name: 'amount', type: 'uint256' }],
    outputs: [{ name: 'sharesReceived', type: 'uint256' }],
    stateMutability: 'nonpayable',
  },
  {
    name: 'previewDeposit',
    type: 'function',
    inputs: [{ name: 'amount', type: 'uint256' }],
    outputs: [{ name: 'shares', type: 'uint256' }],
    stateMutability: 'view',
  },
] as const;

const USDC_ERC20_ABI = [
  {
    name: 'approve',
    type: 'function',
    inputs: [
      { name: 'spender', type: 'address' },
      { name: 'amount',  type: 'uint256' },
    ],
    outputs: [{ name: '', type: 'bool' }],
    stateMutability: 'nonpayable',
  },
] as const;

export async function depositToUSYC(params: {
  walletClient: WalletClient;    // Circle Modular Wallet client
  amountUsdc: number;            // human-readable, e.g. 2400.00
}): Promise<{ txHash: `0x${string}`; usycReceived: number; explorerUrl: string }> {
  const amount = parseUnits(params.amountUsdc.toFixed(6), 6); // USDC = 6 decimals

  // Step 1: Approve USDC spend on Teller
  const approveTx = await params.walletClient.writeContract({
    address: CONTRACTS.USDC,
    abi: USDC_ERC20_ABI,
    functionName: 'approve',
    args: [CONTRACTS.USYC_TELLER, amount],
  });
  await publicClient.waitForTransactionReceipt({ hash: approveTx });

  // Step 2: Deposit via Teller
  const depositTx = await params.walletClient.writeContract({
    address: CONTRACTS.USYC_TELLER,
    abi: TELLER_ABI,
    functionName: 'deposit',
    args: [amount],
  });
  const receipt = await publicClient.waitForTransactionReceipt({ hash: depositTx });

  return {
    txHash: depositTx,
    usycReceived: params.amountUsdc, // 1:1 approximate; parse from receipt events for accuracy
    explorerUrl: `${ARC_TESTNET.explorerUrl}/tx/${depositTx}`,
  };
}

export async function getCurrentAPY(): Promise<number> {
  // TODO: query USYC contract for current yield rate
  // Fallback to hardcoded value for demo stability
  return 5.2;
}
```

> ⚠️ **Entitlement check**: On testnet, verify whether the USYC Teller requires whitelisting via the Entitlements contract (`0xcc205...`). If deposits revert, this is the likely cause — check with Circle docs or testnet support.

