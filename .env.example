# Stakinator — environment variables
# Copy to .env.local and fill in. None of these are committed.

# ── Auth (HMAC for signed session cookies) ──────────────────────────────────
# Any long random string; rotate per environment.
# Required on Vercel — without it auth cookies fail across serverless instances.
NEXTAUTH_SECRET=

# ── Database (Postgres) ─────────────────────────────────────────────────────
# Optional in dev — the repo falls back to an in-memory store if unset.
# Supabase, Neon, local Postgres — anything that speaks the standard URL.
DATABASE_URL=

# ── Anthropic (Claude) ──────────────────────────────────────────────────────
# Used by Inquisitor, Operator: Strategy, and Operator: Loop.
# When missing, all three fall back to deterministic logic so the demo
# still runs end-to-end (no live reasoning trace).
ANTHROPIC_API_KEY=

# ── Circle App Kit (USDC/EURC swap on Arc) ──────────────────────────────────
# Without this, EURC swaps are simulated. USYC deposit is always simulated
# on testnet (Teller allowlist required).
CIRCLE_KIT_KEY=

# ── Arc Testnet ─────────────────────────────────────────────────────────────
# Server-controlled wallet key used for demo execution. The app derives
# per-user keys from this seed; never expose to the browser.
ARC_TESTNET_PRIVATE_KEY=
ARC_RPC_URL=
